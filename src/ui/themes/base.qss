/* src/ui/themes/base.qss */

QWidget {
    background-color: #1a1a2e;
    color: #cdd6f4;
}

QLineEdit {
    background-color: #252538;
    border: 1px solid #313148;
    border-radius: 8px;
    padding: 10px;
    color: #cdd6f4;
}

QLineEdit:focus {
    border: 1px solid #89b4fa;
}

QPushButton {
    background-color: #252538;
    border: 1px solid #313148;
    border-radius: 8px;
    color: #cdd6f4;
    padding: 10px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #313148;
    border: 1px solid #89b4fa;
}

QPushButton:pressed {
    background-color: #1a1a2e;
}

QPushButton#btn_register {
    background-color: transparent;
    border: none;
    color: #89b4fa;
    text-decoration: underline;
    font-weight: normal;
    font-size: 13px;
}

QPushButton#btn_register:hover {
    color: #b4befe;
}

QLabel#error_label {
    color: #f38ba8;
    font-size: 12px;
}

QLabel#title_label {
    font-size: 32px;
    font-weight: bold;
    color: #cdd6f4;
    padding-bottom: 20px;
}

#sidebar {
    background-color: #1a1a1a;
    border-right: 1px solid #2a2a2a;
}

#sidebar QPushButton {
    background-color: transparent;
    border: none;
    border-radius: 10px;
    font-size: 20px;
}
#sidebar QPushButton:hover {
    background-color: #2a2a2a;
}
#sidebar QPushButton:pressed {
    background-color: #3a3a3a;
}

QListWidget {
    background-color: transparent;
    border: none;
    outline: none;
}
QListWidget::item {
    padding: 10px;
    border-radius: 5px;
}
QListWidget::item:hover {
    background-color: #2a2a2a;
}
QListWidget::item:selected {
    background-color: #313148;
    color: #89b4fa;
}

/* ==================== ВКЛАДКИ НАСТРОЕК ==================== */
QTabWidget::pane {
    border: 1px solid #313148;
    background-color: #1a1a2e; /* Фон под вкладками */
}

QTabBar::tab {
    background-color: #e0e0e0; /* Светло-серый фон вкладки (как на скрине) */
    color: #000000;            /* ЧЕРНЫЙ ЦВЕТ ТЕКСТА */
    font-weight: bold;         /* Жирный шрифт для читаемости */
    padding: 8px 16px;
    border: 1px solid #b0b0b0;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #ffffff; /* Активная вкладка — белая */
    color: #000000;            /* Черный текст */
    border-bottom: 2px solid #ffffff; /* Сливается с панелью */
}

QTabBar::tab:hover:!selected {
    background-color: #f0f0f0; /* Чуть светлее при наведении */
}