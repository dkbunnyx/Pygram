# Путь к сетевой папке (обязательно)
SHARED_FOLDER=

# Путь для бэкапов (обязательно)
BACKUP_FOLDER=

# Уровень логирования: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Максимум одновременных аккаунтов
MAX_ACCOUNTS=3

# Время жизни сессии в секундах (86400 = 24 часа)
SESSION_TTL=86400

# Тема оформления: dark или light
THEME=dark